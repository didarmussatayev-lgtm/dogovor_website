# ─── General ──────────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For GitHub Pages use your actual Pages URL, e.g.:
#   CORS_ORIGINS=https://didarmussatayev-lgtm.github.io,http://localhost:5500
# Use * only for development (allows all origins).
CORS_ORIGINS=*

# ─── Google Drive ─────────────────────────────────────────────────────────────
# ID of the Google Drive folder where agreements will be uploaded.
# Copy from the URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=1am2_QQ70rJ03PdTG5Oj1P7DzxEcMhhqt

# Option A (recommended for Railway): paste the full service-account JSON as a
# single-line string. Obtain from Google Cloud Console → IAM → Service Accounts
# → Keys → Add Key → JSON, then minify to one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"dogovor-soglawenie","private_key_id":"adbd62f7afdf863dcb3b310ce985cb8a914d2548","private_key":"-----BEGIN PRIVATE KEY-----\nlWLmhn0oyk8+/5aGTitCd78=-----END PRIVATE KEY-----","client_email":"dogovor-soglawenie@dogovor-soglawenie.iam.gserviceaccount.com","client_id":"101985927243208673215","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/dogovor-soglawenie%40dogovor-soglawenie.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Option B: path to the service-account JSON file (used only when option A is empty).
# Do NOT commit the actual file — it is listed in .gitignore.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ─── Template ─────────────────────────────────────────────────────────────────
# Path to the DOCX template (relative to the backend working directory).
TEMPLATE_PATH=app/templates/soglasie_template.docx
